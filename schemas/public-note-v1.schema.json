{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starlight:public-note:v1",
  "title": "Starlight public note v1",
  "description": "A curated, exportable public knowledge artifact. It is separate from internal notes and private memory vaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "id", "slug", "kind", "visibility", "status", "confidence", "title", "thesis", "evidence", "interpretation", "aspiration", "author", "created", "revisions", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^starlight-note-[0-9]{3,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "enum": ["essay", "principle", "question", "discovery", "warning", "hope"] },
    "visibility": { "const": "public" },
    "status": { "enum": ["working-thesis", "substantiated", "open-question", "superseded"] },
    "confidence": { "enum": ["low", "moderate", "high"] },
    "title": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "claim", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "interpretation": { "type": "string", "minLength": 1 },
    "aspiration": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "created": { "type": "string", "format": "date" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "summary"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "format": "date" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curation", "source", "auditedCommit"],
      "properties": {
        "curation": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" },
        "auditedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
