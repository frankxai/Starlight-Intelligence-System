{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/architecture-blueprint-manifest.schema.json",
  "title": "Starlight Architecture Blueprint Manifest",
  "description": "A provider-aware, evidence-scoped contract for a deployable AI architecture. This is an SIS operational contract, not a SIP substrate amendment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "owner",
    "outcome",
    "surfaces",
    "connections",
    "deploymentOrder",
    "controls",
    "verification"
  ],
  "properties": {
    "$schema": {
      "const": "https://starlightintelligence.org/schemas/architecture-blueprint-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": ["draft", "candidate", "verified", "deprecated"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "repository", "maintainer"],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "maintainer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "statement", "acceptanceCriteria"],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "adapters": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "deploymentOrder": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets", "approvals", "observability", "recovery"],
      "properties": {
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["browserExposure", "storage", "rotationOwner"],
          "properties": {
            "browserExposure": {
              "const": "forbidden"
            },
            "storage": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
              }
            },
            "rotationOwner": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["externalMutationDefault", "irreversibleActions"],
          "properties": {
            "externalMutationDefault": {
              "enum": ["human", "policy-gated"]
            },
            "irreversibleActions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correlationHeader", "requiredSignals"],
          "properties": {
            "correlationHeader": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
            },
            "requiredSignals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "enum": ["logs", "metrics", "traces", "costs", "evals"]
              }
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rollback", "stateBackup", "maximumDataLossMinutes"],
          "properties": {
            "rollback": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "stateBackup": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "maximumDataLossMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "lastVerifiedAt", "checks"],
      "properties": {
        "state": {
          "enum": ["contract-valid", "deploy-tested", "production-proven"]
        },
        "lastVerifiedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/verificationCheck"
          }
        }
      }
    }
  },
  "$defs": {
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "secret", "source", "purpose"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "source": {
          "enum": ["generated", "provider", "operator", "connected-surface"]
        },
        "purpose": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "repository", "rootDirectory", "ref"],
      "properties": {
        "state": {
          "enum": ["planned", "available"]
        },
        "repository": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "rootDirectory": {
          "type": ["string", "null"],
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "ref": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "state", "iacPath", "releaseTemplateRef", "availability"],
      "properties": {
        "method": {
          "enum": ["git", "vercel-project", "railway-project", "container-image"]
        },
        "state": {
          "enum": ["planned", "available", "published"]
        },
        "iacPath": {
          "type": ["string", "null"],
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "releaseTemplateRef": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "availability": {
          "enum": ["on-demand", "always-on", "scheduled"]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "provider",
        "runtime",
        "exposure",
        "responsibilities",
        "units",
        "source",
        "deployment",
        "environment",
        "healthcheck",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "web-cockpit",
            "agent-operator",
            "data-store",
            "queue",
            "model-gateway",
            "integration"
          ]
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "runtime": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "exposure": {
          "enum": ["public", "protected-public", "private"]
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/deploymentUnit"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "environment": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/environmentVariable"
          }
        },
        "healthcheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "expectedStatus"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./{}-]*$"
            },
            "expectedStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        "state": {
          "enum": ["stateless", "database", "persistent-volume", "object-storage"]
        }
      }
    },
    "deploymentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "exposure", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "kind": {
          "enum": ["web-app", "api", "worker", "database", "cache", "volume"]
        },
        "exposure": {
          "enum": ["public", "protected-public", "private"]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "client",
        "protocol",
        "purpose",
        "endpointRef",
        "interface",
        "auth",
        "dataClassification",
        "mutationPolicy",
        "failureMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "client": {
          "enum": ["server", "browser", "worker"]
        },
        "protocol": {
          "enum": ["https", "webhook", "streamable-http", "postgres", "redis", "other"]
        },
        "purpose": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "endpointRef": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "methods"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./{}-]*$"
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "sourceSecretRef", "targetSecretRef"],
          "properties": {
            "mode": {
              "enum": ["none", "service-token", "bearer-token", "oauth2-pkce", "mtls"]
            },
            "sourceSecretRef": {
              "type": ["string", "null"],
              "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
            },
            "targetSecretRef": {
              "type": ["string", "null"],
              "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
            }
          }
        },
        "dataClassification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "mutationPolicy": {
          "enum": ["read-only", "approval-required", "policy-gated"]
        },
        "failureMode": {
          "enum": ["fail-closed", "degrade-read-only", "retry-bounded", "queue"]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attachesTo", "state", "required", "purpose", "sourceRef", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
        },
        "attachesTo": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "state": {
          "enum": ["planned", "available", "verified"]
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "sourceRef": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "evidence": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "kind", "command", "expected", "required", "status", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
        },
        "target": {
          "type": "string",
          "pattern": "^(?:manifest|[a-z0-9][a-z0-9-]{1,63})$"
        },
        "kind": {
          "enum": ["schema", "build", "health", "integration", "security", "rollback"]
        },
        "command": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "expected": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": ["planned", "passed", "failed"]
        },
        "evidence": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    }
  }
}
