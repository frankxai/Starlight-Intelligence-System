{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.ai/schemas/fleet-host-observation-v0.json",
  "title": "Starlight Read-Only Host Scout Observation",
  "description": "Local unsigned observation; the server MUST NOT interpret any field as execution authority.",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "host", "resources", "harnesses", "skills", "mcpServers", "plugins", "projectPackages", "sessions", "cloudSessions", "permission", "privacy", "observationSha256"],
  "properties": {
    "schemaVersion": {"const": "starlight.host-observation.v0"},
    "observedAt": {"type": "string", "format": "date-time"},
    "host": {
      "type": "object", "required": ["claimedMachineId", "osHostname", "platform", "identity"],
      "properties": {
        "claimedMachineId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "osHostname": {"type": "string", "minLength": 1},
        "platform": {"type": "string"},
        "arch": {"type": "string"},
        "identity": {"const": "locally_observed_not_attested"}
      }
    },
    "resources": {"type": "object"},
    "harnesses": {"type": "array", "items": {"type": "object"}},
    "skills": {"type": "array", "items": {"type": "object"}},
    "mcpServers": {"type": "array", "items": {"type": "object"}},
    "plugins": {"type": "array", "items": {"type": "object"}},
    "projectPackages": {"type": "array", "items": {"type": "object"}},
    "sessions": {"type": "object"},
    "cloudSessions": {"type": "object"},
    "permission": {"type": "object", "required": ["remoteDispatch", "verifiedHost"], "properties": {"remoteDispatch": {"const": "not_authorized"}, "verifiedHost": {"const": false}}, "additionalProperties": true},
    "privacy": {"type": "object", "required": ["rawConfigValuesIncluded", "secretsIncluded", "observationSigned"], "properties": {"rawConfigValuesIncluded": {"const": false}, "secretsIncluded": {"const": false}, "observationSigned": {"const": false}}, "additionalProperties": true},
    "observationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
