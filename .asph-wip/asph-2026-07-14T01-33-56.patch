+        return rows
+          .filter(row => row.bank === input.bank_id && row.content.toLowerCase().includes(input.query.toLowerCase()))
+          .map((row, index): HindsightRecallRow => ({
+            id: `hs_${index + 1}`,
+            text: row.content,
+            score: 0.91,
+            document_id: row.documentId,
+            metadata: row.metadata,
+          }));
+      },
