{
  "name": "@arcanea/starlight-intelligence-system",
  "version": "7.6.0",
  "description": "Starlight Intelligence System — substrate (SIP protocol, alliance forging method, attestation) + reference operational layer (6 semantic vaults, SQLite hybrid retrieval, temporal reasoning, MCP server, platform adapters)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator.d.ts",
      "import": "./dist/orchestrator.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./score": {
      "types": "./dist/score.d.ts",
      "import": "./dist/score.js"
    },
    "./vaults": {
      "types": "./dist/vault-memory.d.ts",
      "import": "./dist/vault-memory.js"
    },
    "./guidance": {
      "types": "./dist/guidance.d.ts",
      "import": "./dist/guidance.js"
    },
    "./multi-sync": {
      "types": "./dist/multi-sync.d.ts",
      "import": "./dist/multi-sync.js"
    },
    "./retrieval": {
      "types": "./dist/retrieval.d.ts",
      "import": "./dist/retrieval.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    },
    "./contradiction": {
      "types": "./dist/contradiction.d.ts",
      "import": "./dist/contradiction.js"
    },
    "./dreaming": {
      "types": "./dist/dreaming.d.ts",
      "import": "./dist/dreaming.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js"
    },
    "./starlight-mcp": {
      "types": "./dist/starlight-mcp.d.ts",
      "import": "./dist/starlight-mcp.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "npm run test:operational && npm run test:substrate",
    "test:substrate": "node --import tsx --test test/substrate.test.ts && node --import tsx --test test/v73.test.ts && node --import tsx --test test/v74.test.ts && node --import tsx --test test/v741.test.ts && node --import tsx --test test/v75.test.ts",
    "test:operational": "node --import tsx --test src/orchestrator.test.ts",
    "generate-context": "node dist/cli.js generate",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test:substrate"
  },
  "files": [
    "dist/",
    "context/",
    "README.md"
  ],
  "keywords": [
    "ai",
    "ai-agents",
    "context-engineering",
    "persistent-memory",
    "cognitive-architecture",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "platform-adapters"
  ],
  "author": "FrankX <frank@frankx.ai>",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@arcanea/memory-system": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@arcanea/memory-system": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "starlight": "dist/cli.js",
    "starlight-mcp": "dist/mcp-server.js",
    "starlight-substrate-mcp": "dist/starlight-mcp.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0"
  }
}
