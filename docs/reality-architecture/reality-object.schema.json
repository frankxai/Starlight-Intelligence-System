{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/reality-object.v0.1.schema.json",
  "title": "Starlight Reality Object v0.1",
  "description": "Seed contract for typed, epistemically explicit objects across real, inferred, planned, simulated and fictional realms.",
  "type": "object",
  "required": ["id", "type", "label", "existence", "epistemics", "provenance", "temporal"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "description": "Globally stable ecosystem identifier. Do not encode mutable display names into identity when avoidable."
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "existence": {
      "type": "object",
      "required": ["realm", "status"],
      "properties": {
        "realm": {
          "enum": ["real", "inferred", "planned", "hypothetical", "simulated", "fictional"]
        },
        "status": {
          "enum": ["observed", "asserted", "inferred", "proposed", "candidate", "canonical", "deprecated", "unknown"]
        },
        "world_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "epistemics": {
      "type": "object",
      "required": ["kind", "confidence"],
      "properties": {
        "kind": {
          "enum": ["empirical", "mathematical", "scientific_model", "inference", "philosophical", "theological", "mythological", "symbolic", "speculative", "simulation", "fictional", "preference", "unknown"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "claim_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "enum": ["human", "repository", "database", "sensor", "paper", "website", "model", "agent", "simulation", "fictional_canon", "import", "unknown"]
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "created_by": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "derived_from": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "transformation": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "temporal": {
      "type": "object",
      "required": ["observed_at"],
      "properties": {
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "state_version": {
          "type": ["integer", "string", "null"]
        }
      },
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "causal_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/causalClaim"}
    },
    "values": {
      "type": "array",
      "items": {"$ref": "#/$defs/valueLink"}
    },
    "representations": {
      "type": "array",
      "items": {"$ref": "#/$defs/representation"}
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/actionRef"}
    },
    "branch_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {"type": ["string", "array"]}
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": ["type", "target_id"],
      "properties": {
        "type": {"type": "string"},
        "target_id": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "provenance_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "causalClaim": {
      "type": "object",
      "required": ["effect_id", "direction", "epistemic_kind"],
      "properties": {
        "effect_id": {"type": "string"},
        "direction": {"enum": ["increases", "decreases", "enables", "prevents", "changes", "unknown"]},
        "mechanism": {"type": ["string", "null"]},
        "epistemic_kind": {"enum": ["measured", "experimental", "observational", "modeled", "assumed", "fictional_rule", "unknown"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "valueLink": {
      "type": "object",
      "required": ["value_id", "stance"],
      "properties": {
        "value_id": {"type": "string"},
        "stance": {"enum": ["supports", "opposes", "serves", "trades_off", "unknown"]},
        "holder_id": {"type": ["string", "null"]},
        "weight": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "representation": {
      "type": "object",
      "required": ["kind", "uri"],
      "properties": {
        "kind": {"enum": ["text", "code", "image", "audio", "video", "scene", "document", "dataset", "other"]},
        "uri": {"type": "string"},
        "canonical": {"type": "boolean", "default": false},
        "content_hash": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "actionRef": {
      "type": "object",
      "required": ["action_id", "governance"],
      "properties": {
        "action_id": {"type": "string"},
        "governance": {"enum": ["read_only", "autonomous_bounded", "supervised", "human_gate", "prohibited"]},
        "tool_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}
