{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/reality-object.v0.1.1.schema.json",
  "title": "Starlight Reality Object v0.1.1",
  "description": "Typed, epistemically explicit object. Board harden of v0.1 seed: stable ID pattern, tighter critical blocks, optional confidence (not required-null).",
  "type": "object",
  "required": ["id", "type", "label", "existence", "epistemics", "provenance", "temporal"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^ra:[a-z][a-z0-9_-]*:[a-zA-Z0-9._~/-]{1,200}$",
      "description": "Globally stable ecosystem identifier. Pattern ra:<class>:<local>."
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Prefer type-registry.v0.json objectTypes; free string allowed only with type_registry_note."
    },
    "type_registry_note": {
      "type": "string",
      "description": "Required rationale when type is outside the published registry."
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "existence": {
      "type": "object",
      "required": ["realm", "status"],
      "additionalProperties": false,
      "properties": {
        "realm": {
          "enum": ["real", "inferred", "planned", "desired", "hypothetical", "simulated", "fictional"]
        },
        "status": {
          "enum": ["observed", "asserted", "inferred", "proposed", "candidate", "canonical", "deprecated", "unknown"]
        },
        "world_id": {
          "type": ["string", "null"]
        }
      }
    },
    "epistemics": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "empirical",
            "mathematical",
            "scientific_model",
            "inference",
            "philosophical",
            "theological",
            "mythological",
            "symbolic",
            "speculative",
            "simulation",
            "fictional",
            "preference",
            "unknown"
          ]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "claim_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_type"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": [
            "human",
            "repository",
            "database",
            "sensor",
            "paper",
            "website",
            "model",
            "agent",
            "simulation",
            "fictional_canon",
            "import",
            "unknown"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "created_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "derived_from": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "transformation": {
          "type": ["string", "null"]
        }
      }
    },
    "temporal": {
      "type": "object",
      "required": ["observed_at"],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this representation was observed/asserted. Required non-null for durable objects."
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "state_version": {
          "type": ["integer", "string", "null"]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "causal_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/causalClaim" }
    },
    "values": {
      "type": "array",
      "items": { "$ref": "#/$defs/valueLink" }
    },
    "representations": {
      "type": "array",
      "items": { "$ref": "#/$defs/representation" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionRef" }
    },
    "branch_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "array"]
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": ["type", "target_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "target_id": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "valid_from": { "type": ["string", "null"], "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required in application logic when asserting real/observed fact edges (maps to graph-edge.evidenceRef)."
        },
        "provenance_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "causalClaim": {
      "type": "object",
      "required": ["effect_id", "direction", "epistemic_kind"],
      "additionalProperties": false,
      "properties": {
        "effect_id": { "type": "string" },
        "direction": {
          "enum": ["increases", "decreases", "enables", "prevents", "changes", "unknown"]
        },
        "mechanism": { "type": ["string", "null"] },
        "epistemic_kind": {
          "enum": ["measured", "experimental", "observational", "modeled", "assumed", "fictional_rule", "unknown"]
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "valueLink": {
      "type": "object",
      "required": ["value_id", "stance"],
      "additionalProperties": false,
      "properties": {
        "value_id": { "type": "string" },
        "stance": {
          "enum": ["supports", "opposes", "serves", "trades_off", "unknown"]
        },
        "holder_id": { "type": ["string", "null"] },
        "weight": { "type": ["number", "null"] }
      }
    },
    "representation": {
      "type": "object",
      "required": ["kind", "uri"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["text", "code", "image", "audio", "video", "scene", "document", "dataset", "other"]
        },
        "uri": { "type": "string" },
        "canonical": { "type": "boolean", "default": false },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "actionRef": {
      "type": "object",
      "required": ["action_id", "governance"],
      "additionalProperties": false,
      "properties": {
        "action_id": { "type": "string" },
        "governance": {
          "enum": ["read_only", "autonomous_bounded", "supervised", "human_gate", "prohibited"]
        },
        "tool_ref": { "type": ["string", "null"] }
      }
    }
  }
}
