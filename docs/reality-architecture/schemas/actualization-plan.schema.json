{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/actualization-plan.v0.1.1.schema.json",
  "title": "Starlight Actualization Plan v0.1.1",
  "description": "Governed plan compiled from a RealityDiff into experiments/actions. Compiles into WorkPackets; does not bypass Swarm gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "diff_id", "branch_id", "actions", "created_at", "status"],
  "properties": {
    "schemaVersion": { "const": "0.1.1" },
    "id": {
      "type": "string",
      "pattern": "^ra:plan:[a-zA-Z0-9._~/-]{1,200}$"
    },
    "diff_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "gap_ids",
          "owner",
          "tool",
          "governance_tier",
          "expected_evidence",
          "verification_criterion",
          "stop_condition"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "gap_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["human", "agent", "team"] },
              "id": { "type": "string" }
            }
          },
          "tool": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cost_estimate": { "type": ["number", "null"], "minimum": 0 },
          "risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "governance_tier": {
            "enum": ["read_only", "autonomous_bounded", "supervised", "human_gate", "prohibited"]
          },
          "expected_evidence": { "type": "string", "minLength": 3 },
          "verification_criterion": { "type": "string", "minLength": 3 },
          "stop_condition": { "type": "string", "minLength": 3 },
          "rollback": { "type": ["string", "null"] },
          "work_packet_id": { "type": ["string", "null"] }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": ["string", "null"] },
    "status": {
      "enum": ["draft", "proposed", "admitted", "executing", "completed", "failed", "cancelled"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
