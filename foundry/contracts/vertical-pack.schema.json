{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/vertical-pack.schema.json",
  "title": "Starlight Foundry Vertical Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "status",
    "description",
    "audiences",
    "domainConstraints",
    "ontology",
    "canonicalSources",
    "userJobs",
    "artifactTaxonomy",
    "capabilities",
    "tasteProfile",
    "riskPolicy",
    "evaluation",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "vertical"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "experimental",
        "validated",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "domainConstraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "decisions"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,119}$"
          }
        }
      }
    },
    "canonicalSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "required"
      ],
      "properties": {
        "policy": {
          "enum": [
            "current-primary-sources",
            "stable-primary-sources",
            "workspace-authoritative",
            "mixed-declared"
          ]
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "userJobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,119}$"
      }
    },
    "artifactTaxonomy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,119}$"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:/-]{1,127}$"
      }
    },
    "tasteProfile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/-]{1,127}$"
    },
    "riskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "irreversible",
        "approvalRequired"
      ],
      "properties": {
        "irreversible": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "approvalRequired": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "external-write",
              "destructive-action",
              "deployment",
              "financial-commitment",
              "public-release",
              "permission-expansion",
              "substrate-change"
            ]
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredLanes",
        "minimumPassRate"
      ],
      "properties": {
        "requiredLanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "static",
              "behavioral",
              "factual",
              "artifact",
              "taste",
              "security",
              "economic",
              "drift"
            ]
          }
        },
        "minimumPassRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chatgpt",
              "chatgpt-work",
              "codex",
              "claude-code",
              "gemini",
              "agents-sdk",
              "mcp",
              "plugin"
            ]
          }
        }
      }
    }
  }
}
