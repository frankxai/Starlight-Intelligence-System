{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/skill-pack.schema.json",
  "title": "Starlight Foundry Skill Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "description",
    "triggers",
    "procedure",
    "inputs",
    "outputs",
    "dependencies",
    "toolPolicy",
    "memoryContract",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "skill"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction",
          "proof"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          },
          "proof": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/-]{1,127}$"
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "deny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "memoryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write"
      ],
      "properties": {
        "read": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "tasteProfile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/-]{1,127}$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implicitInvocation",
        "targets"
      ],
      "properties": {
        "implicitInvocation": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chatgpt",
              "chatgpt-work",
              "codex",
              "claude-code",
              "gemini",
              "plugin"
            ]
          }
        }
      }
    }
  }
}
