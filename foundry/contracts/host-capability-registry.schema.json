{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/host-capability-registry.schema.json",
  "title": "Starlight Foundry Host Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedAt",
    "defaultReceiptTtlDays",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "defaultReceiptTtlDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ecosystem",
          "surface",
          "priority",
          "lifecycle",
          "adapterTier",
          "packageFormats",
          "distribution",
          "ui",
          "headlessValidation",
          "humanGates",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
          },
          "ecosystem": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "surface": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "priority": {
            "enum": [
              "p0",
              "p1",
              "p2",
              "excluded"
            ]
          },
          "lifecycle": {
            "enum": [
              "primary",
              "compatibility",
              "experimental",
              "beta",
              "sunset"
            ]
          },
          "adapterTier": {
            "enum": [
              "portable",
              "native",
              "mcp-only",
              "instruction-pack",
              "unsupported"
            ]
          },
          "packageFormats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{1,79}$"
            }
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "listing",
              "publishAutomation"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "public-marketplace",
                  "private-marketplace",
                  "curated-directory",
                  "git",
                  "npm",
                  "direct-url",
                  "host-console",
                  "none"
                ]
              },
              "listing": {
                "enum": [
                  "self-service",
                  "reviewed",
                  "direct",
                  "closed-beta",
                  "none"
                ]
              },
              "publishAutomation": {
                "enum": [
                  "api",
                  "partial",
                  "none"
                ]
              }
            }
          },
          "ui": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "mcp-apps",
                "a2ui",
                "host-cards",
                "host-native",
                "standalone-web",
                "text-only",
                "none"
              ]
            }
          },
          "headlessValidation": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "humanGates": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
