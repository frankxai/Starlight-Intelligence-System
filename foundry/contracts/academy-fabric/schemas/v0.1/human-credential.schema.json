{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starlightintelligence.org/academy-fabric/v0.1/human-credential.schema.json",
  "title": "HumanCredential",
  "description": "Immutable bounded competence claim issued to a human after evidence-linked assessment and an authorised human decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "credentialType", "subjectRef", "achievement", "competencyClaims", "missionContractRef", "evidenceBundleRefs", "assessment", "assistanceDisclosure", "issuerRef", "issuedAt", "validFrom", "validUntil", "status", "statusEndpoint", "recognition", "appealPolicyRef", "verification"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/CanonicalMetadata" },
    "credentialType": { "type": "string", "enum": ["completion", "academy_microcredential", "verified_professional", "recognised_partner", "personnel_certification"] },
    "subjectRef": { "$ref": "common.schema.json#/$defs/HumanRef" },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "criteriaRef", "workloadHours"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/StableId" },
        "name": { "$ref": "common.schema.json#/$defs/ShortText" },
        "description": { "$ref": "common.schema.json#/$defs/NonEmptyText" },
        "criteriaRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "workloadHours": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
      }
    },
    "competencyClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/CompetencyClaim" },
          { "type": "object", "properties": { "claimState": { "const": "credentialed" } }, "required": ["evidenceRefs"] }
        ]
      }
    },
    "missionContractRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
    "evidenceBundleRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "rubricRefs", "assessmentEnvironmentDigest", "decision"],
      "properties": {
        "method": { "type": "string", "enum": ["artifact_review", "live_defense", "unseen_transfer", "workplace_observation", "combined"] },
        "rubricRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
        "assessmentEnvironmentDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "assessorCopilotAttestationRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "decision": { "$ref": "common.schema.json#/$defs/DecisionRecord" },
        "calibrationRunRef": { "$ref": "common.schema.json#/$defs/StableId" }
      }
    },
    "assistanceDisclosure": { "$ref": "common.schema.json#/$defs/AssistanceDisclosure" },
    "issuerRef": { "$ref": "common.schema.json#/$defs/OrganisationRef" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "suspended", "revoked", "expired"] },
    "statusEndpoint": { "type": "string", "format": "uri" },
    "statusListIndex": { "type": "integer", "minimum": 0 },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "disclosure"],
      "properties": {
        "scope": { "type": "string", "enum": ["private_nonformal", "partner_endorsed", "credit_bearing", "formally_recognised", "personnel_certification"] },
        "disclosure": { "$ref": "common.schema.json#/$defs/NonEmptyText" },
        "authoritativeRecognitionRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "jurisdiction": { "type": "string", "maxLength": 64 },
        "levelFrameworkRef": { "$ref": "common.schema.json#/$defs/VersionedRef" }
      }
    },
    "appealPolicyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
    "appealCaseRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" } },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "effectiveAt", "decisionRef"],
      "properties": {
        "reasonCode": { "type": "string", "enum": ["fraud", "material_error", "issuer_policy", "scope_breach", "superseded", "holder_request", "other"] },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "decisionRef": { "$ref": "common.schema.json#/$defs/StableId" },
        "publicReason": { "$ref": "common.schema.json#/$defs/NonEmptyText" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "credentialDigest", "proof"],
      "properties": {
        "format": { "type": "string", "enum": ["academy-fabric", "open-badges-3", "w3c-vc-2", "clr-2", "europass-edc"] },
        "credentialDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "proof": { "$ref": "common.schema.json#/$defs/Signature" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/NamespacedExtensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
      "then": { "required": ["revocation"] }
    },
    {
      "if": { "properties": { "recognition": { "type": "object", "properties": { "scope": { "enum": ["credit_bearing", "formally_recognised", "personnel_certification"] } } } } },
      "then": { "properties": { "recognition": { "type": "object", "required": ["authoritativeRecognitionRef", "jurisdiction"] } } }
    }
  ]
}
