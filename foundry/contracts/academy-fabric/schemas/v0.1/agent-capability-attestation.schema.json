{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starlightintelligence.org/academy-fabric/v0.1/agent-capability-attestation.schema.json",
  "title": "AgentCapabilityAttestation",
  "description": "Short-lived conformance claim for one immutable agent build operating within one bounded environment and permission set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "status", "agentDefinitionRef", "agentBuildRef", "controllerRef", "serviceIdentityRef", "runtime", "packages", "interfaces", "toolAndDataScopes", "evaluations", "validFrom", "validUntil", "driftPolicyRef", "incidentPolicyRef", "verification"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/CanonicalMetadata" },
    "status": { "type": "string", "enum": ["active", "suspended", "revoked", "expired", "superseded"] },
    "agentDefinitionRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
    "agentBuildRef": { "$ref": "common.schema.json#/$defs/AgentBuildRef" },
    "controllerRef": { "$ref": "common.schema.json#/$defs/OrganisationRef" },
    "serviceIdentityRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeRef", "modelRef", "executionImageDigest", "region", "sandboxClass"],
      "properties": {
        "runtimeRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "modelRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "executionImageDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "region": { "type": "string", "maxLength": 64 },
        "sandboxClass": { "type": "string", "enum": ["declarative_policy", "WASI", "gVisor", "Firecracker", "Kata"] },
        "memoryPolicyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptPackageRef", "skillPackageRefs", "dependencyLockRef", "sbomRef", "supplyChainProvenanceRef"],
      "properties": {
        "promptPackageRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "skillPackageRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
        "dependencyLockRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "sbomRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "supplyChainProvenanceRef": { "$ref": "common.schema.json#/$defs/VersionedRef" }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "interfaceRef", "declaredCapabilityRefs"],
        "properties": {
          "protocol": { "type": "string", "enum": ["MCP", "A2A", "HTTP", "event", "CLI"] },
          "interfaceRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
          "declaredCapabilityRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/StableId" } },
          "audience": { "type": "string", "format": "uri" }
        }
      }
    },
    "toolAndDataScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "resourceRefs", "dataClassifications", "credentialBrokerRequired", "defaultDenyEgress"],
      "properties": {
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" } },
        "resourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/StableId" } },
        "dataClassifications": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/DataClassification" } },
        "dataResidency": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "credentialBrokerRequired": { "const": true },
        "defaultDenyEgress": { "const": true }
      }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteRefs", "resultEvidenceBundleRef", "capabilityClaims", "safetyClaims", "evaluatedAt"],
      "properties": {
        "suiteRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
        "resultEvidenceBundleRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "capabilityClaims": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/CompetencyClaim" } },
        "safetyClaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "outcome", "evidenceRef"],
            "properties": {
              "claim": { "$ref": "common.schema.json#/$defs/ShortText" },
              "outcome": { "type": "string", "enum": ["pass", "fail", "conditional", "not_evaluated"] },
              "evidenceRef": { "$ref": "common.schema.json#/$defs/VersionedRef" }
            }
          }
        },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "independentReviewerRef": { "$ref": "common.schema.json#/$defs/HumanRef" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "driftPolicyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
    "incidentPolicyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
    "incidentRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" } },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "effectiveAt", "decisionRef"],
      "properties": {
        "reasonCode": { "type": "string", "enum": ["build_changed", "permission_changed", "data_boundary_changed", "evaluation_regression", "incident", "controller_request", "superseded", "other"] },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "decisionRef": { "$ref": "common.schema.json#/$defs/StableId" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestationDigest", "proof", "statusEndpoint"],
      "properties": {
        "attestationDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "proof": { "$ref": "common.schema.json#/$defs/Signature" },
        "statusEndpoint": { "type": "string", "format": "uri" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/NamespacedExtensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": {
        "properties": {
          "evaluations": {
            "type": "object",
            "required": ["independentReviewerRef"]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
      "then": { "required": ["revocation"] }
    }
  ]
}
