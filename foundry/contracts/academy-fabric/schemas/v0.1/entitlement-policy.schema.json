{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starlightintelligence.org/academy-fabric/v0.1/entitlement-policy.schema.json",
  "title": "EntitlementPolicy",
  "description": "Versioned deterministic rules for optional capacity grants and managed services without gating the public learning, evidence, export, or credential path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "status", "issuerRef", "accessBasis", "eligibilityRules", "grants", "usageLimits", "validity", "accessNeutrality", "financialGuardrails", "agentAuthority", "revocationPolicyRef"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/CanonicalMetadata" },
    "status": { "type": "string", "enum": ["draft", "active", "suspended", "retired"] },
    "issuerRef": { "$ref": "common.schema.json#/$defs/OrganisationRef" },
    "accessBasis": { "type": "string", "enum": ["public_open", "local", "commons", "contribution", "institution", "sponsored", "scholarship", "purchased"] },
    "offerRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
    "eligibilityRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "factType", "operator", "expectedValue", "failureCode"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
          "factType": { "type": "string", "enum": ["public_open", "local_execution", "byok_configured", "commons_participation", "resource_grant_active", "payment_cleared", "sponsorship_awarded", "scholarship_awarded", "institution_membership", "cohort_enrollment", "credential_active", "contribution_accepted", "manual_approval"] },
          "operator": { "type": "string", "enum": ["equals", "in", "gte", "lte", "exists"] },
          "expectedValue": {},
          "failureCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "factIssuerRef": { "$ref": "common.schema.json#/$defs/EntityRef" }
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceRef", "actions", "audience", "purpose"],
        "properties": {
          "resourceRef": { "$ref": "common.schema.json#/$defs/StableId" },
          "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" } },
          "audience": { "type": "string", "format": "uri" },
          "purpose": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "usageLimits": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/UsageLimit" } },
    "validity": { "$ref": "common.schema.json#/$defs/TimeWindow" },
    "accessNeutrality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curriculumAccessUnaffected", "missionAccessUnaffected", "assessmentStandardIdentical", "credentialEligibilityUnaffected", "passportExportUnaffected", "learnerEvidenceRightsUnaffected"],
      "properties": {
        "curriculumAccessUnaffected": { "const": true },
        "missionAccessUnaffected": { "const": true },
        "assessmentStandardIdentical": { "const": true },
        "credentialEligibilityUnaffected": { "const": true },
        "passportExportUnaffected": { "const": true },
        "learnerEvidenceRightsUnaffected": { "const": true }
      }
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "termsRef", "agentMayChangeTerms"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "manual", "automatic_with_prior_consent"] },
        "termsRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "noticeDays": { "type": "integer", "minimum": 0, "maximum": 365 },
        "agentMayChangeTerms": { "const": false }
      }
    },
    "scholarshipAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fundRef", "ruleRef", "deterministic", "humanAppealAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "fundRef": { "$ref": "common.schema.json#/$defs/StableId" },
        "ruleRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "deterministic": { "const": true },
        "humanAppealAvailable": { "const": true },
        "maxAllocation": { "$ref": "common.schema.json#/$defs/Money" }
      }
    },
    "contributorPayoutPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "calculationRuleRef", "humanReleaseRequired", "disputedPayoutReleaseAllowed"],
      "properties": {
        "enabled": { "type": "boolean" },
        "calculationRuleRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "humanReleaseRequired": { "const": true },
        "disputedPayoutReleaseAllowed": { "const": false }
      }
    },
    "financialGuardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debtCreationAllowed", "unapprovedDiscountsAllowed", "agentDefinedRevenueShareAllowed", "negativeBalanceAllowed"],
      "properties": {
        "debtCreationAllowed": { "const": false },
        "unapprovedDiscountsAllowed": { "const": false },
        "agentDefinedRevenueShareAllowed": { "const": false },
        "negativeBalanceAllowed": { "const": false },
        "approvedSpendCap": { "$ref": "common.schema.json#/$defs/Money" }
      }
    },
    "agentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedActions", "prohibitedActions"],
      "properties": {
        "allowedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["evaluate_eligibility", "provision_approved_access", "meter_usage", "refresh_approved_resource_envelope", "refresh_approved_budget", "allocate_deterministic_scholarship", "prepare_payout", "draft_notice"] }
        },
        "prohibitedActions": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "create_debt" } },
            { "contains": { "const": "invent_discount" } },
            { "contains": { "const": "alter_renewal_terms" } },
            { "contains": { "const": "define_revenue_share" } },
            { "contains": { "const": "release_disputed_payout" } },
            { "contains": { "const": "bypass_human_approval" } }
          ],
          "items": { "type": "string", "enum": ["create_debt", "invent_discount", "alter_renewal_terms", "define_revenue_share", "release_disputed_payout", "bypass_human_approval", "change_price", "issue_refund_outside_policy"] }
        }
      }
    },
    "revocationPolicyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
    "extensions": { "$ref": "common.schema.json#/$defs/NamespacedExtensions" }
  },
  "$defs": {
    "EntitlementDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectRef", "policyRef", "inputFactRefs", "decision", "reasonCodes", "evaluatedAt", "evaluatedByRef", "validity", "idempotencyKey"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/StableId" },
        "subjectRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "policyRef": { "$ref": "common.schema.json#/$defs/VersionedRef" },
        "inputFactRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/VersionedRef" } },
        "decision": { "type": "string", "enum": ["grant", "deny", "manual_review", "revoke"] },
        "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "evaluatedByRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "humanApprovalRef": { "$ref": "common.schema.json#/$defs/StableId" },
        "validity": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
        "supersedesDecisionRef": { "$ref": "common.schema.json#/$defs/StableId" }
      }
    }
  }
}
