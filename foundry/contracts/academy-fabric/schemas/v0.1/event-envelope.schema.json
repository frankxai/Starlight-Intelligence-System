{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starlightintelligence.org/academy-fabric/v0.1/event-envelope.schema.json",
  "title": "Academy Fabric Event Envelope",
  "description": "CloudEvents 1.0-compatible append-only event with tenancy, causality, authority, policy, privacy, replay, and trace context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "tenantid", "academyid", "correlationid", "causationid", "actorref", "policydecisionref", "idempotencykey", "classification", "traceparent", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 16, "maxLength": 128 },
    "source": { "type": "string", "format": "uri-reference" },
    "type": { "type": "string", "pattern": "^org\\.starlight\\.academy\\.[a-z0-9.-]+\\.v[1-9][0-9]*$", "maxLength": 255 },
    "subject": { "$ref": "common.schema.json#/$defs/StableId" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri" },
    "tenantid": { "$ref": "common.schema.json#/$defs/StableId" },
    "academyid": { "$ref": "common.schema.json#/$defs/StableId" },
    "correlationid": { "type": "string", "minLength": 8, "maxLength": 128 },
    "causationid": { "type": "string", "minLength": 8, "maxLength": 128 },
    "actorref": { "$ref": "common.schema.json#/$defs/StableId" },
    "delegationref": { "$ref": "common.schema.json#/$defs/StableId" },
    "policydecisionref": { "$ref": "common.schema.json#/$defs/StableId" },
    "consentref": { "$ref": "common.schema.json#/$defs/StableId" },
    "idempotencykey": { "type": "string", "minLength": 16, "maxLength": 128 },
    "classification": { "$ref": "common.schema.json#/$defs/DataClassification" },
    "traceparent": { "type": "string", "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[0-9a-f]{2}$" },
    "eventexpiry": { "type": "string", "format": "date-time" },
    "signaturekeyid": { "type": "string", "format": "uri" },
    "starlightsignature": { "type": "string", "minLength": 16, "maxLength": 32768 },
    "data": { "type": "object" }
  }
}
