{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/openai-submission-profile.schema.json",
  "title": "OpenAI Plugin Source Preflight Gate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "dossierId",
    "state",
    "package",
    "channel",
    "listing",
    "identity",
    "policy",
    "experience",
    "reviewTests",
    "evidence",
    "humanGates",
    "officialSourceUrls",
    "claimBoundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://starlightintelligence.org/schemas/foundry/openai-submission-profile.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "dossierId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,159}$"
    },
    "state": {
      "enum": [
        "draft",
        "preflight-ready",
        "external-gates-pending",
        "blocked"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "submissionType", "portableManifest", "openaiManifest", "payloadSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "submissionType": { "const": "skills-only" },
        "portableManifest": { "type": "string", "minLength": 1, "maxLength": 500 },
        "openaiManifest": { "type": "string", "minLength": 1, "maxLength": 500 },
        "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "channel": {
      "const": "universal-directory"
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "category", "logo", "composerIcon", "releaseNotes"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "logo": { "type": "string", "minLength": 1, "maxLength": 500 },
        "composerIcon": { "type": "string", "minLength": 1, "maxLength": 500 },
        "releaseNotes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisherMode", "verificationState", "appsManagementWrite"],
      "properties": {
        "publisherMode": { "enum": ["undecided", "individual", "business"] },
        "verificationState": { "enum": ["pending", "verified", "blocked"] },
        "appsManagementWrite": { "enum": ["pending", "confirmed", "blocked"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commerceMode",
        "digitalCheckoutEnabled",
        "privacyUrl",
        "termsUrl",
        "supportUrl",
        "controllerMatchesVerifiedPublisher"
      ],
      "properties": {
        "commerceMode": { "enum": ["no-commerce", "existing-entitlements-only", "physical-goods-only"] },
        "digitalCheckoutEnabled": { "const": false },
        "privacyUrl": { "type": ["string", "null"], "pattern": "^https://", "maxLength": 1000 },
        "termsUrl": { "type": ["string", "null"], "pattern": "^https://", "maxLength": 1000 },
        "supportUrl": { "type": ["string", "null"], "pattern": "^https://", "maxLength": 1000 },
        "controllerMatchesVerifiedPublisher": { "type": "boolean" }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customUi", "screenshots", "reviewRecordingRequired"],
      "properties": {
        "customUi": { "const": false },
        "screenshots": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "reviewRecordingRequired": { "const": false }
      }
    },
    "reviewTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/reviewTest" }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/reviewTest" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portableConformanceReport",
        "openaiPreflightReport",
        "skillsBundleScan",
        "chatgptRuntime",
        "codexRuntime",
        "reviewOutcome"
      ],
      "properties": {
        "portableConformanceReport": { "type": ["string", "null"], "maxLength": 1000 },
        "openaiPreflightReport": { "type": ["string", "null"], "maxLength": 1000 },
        "skillsBundleScan": { "type": ["string", "null"], "maxLength": 1000 },
        "chatgptRuntime": { "type": ["string", "null"], "maxLength": 1000 },
        "codexRuntime": { "type": ["string", "null"], "maxLength": 1000 },
        "reviewOutcome": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "humanGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "status", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "enum": ["pending", "blocked", "complete"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "officialSourceUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://" }
    },
    "claimBoundary": {
      "const": "Structural dossier validation is preflight evidence only; it cannot establish submitted, approved, published, runtime-verified, or supported state. External strong states require digest-bound host evidence and a live attestation verifier."
    }
  },
  "$defs": {
    "reviewTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expectedBehavior", "status", "observedBehavior", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "expectedBehavior": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "const": "pending-external-run" },
        "observedBehavior": { "const": null },
        "evidenceRefs": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
