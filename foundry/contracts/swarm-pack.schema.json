{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/swarm-pack.schema.json",
  "title": "Starlight Foundry Swarm Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "description",
    "topology",
    "roles",
    "sharedState",
    "conflictResolution",
    "termination",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "swarm"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "topology": {
      "enum": [
        "manager-workers",
        "handoff",
        "agents-as-tools",
        "parallel-merge",
        "debate-synthesize"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capabilities",
          "decisionRights",
          "produces"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9:/-]{1,127}$"
            }
          },
          "decisionRights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "produces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "sharedState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "writePolicy"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 500
        },
        "writePolicy": {
          "enum": [
            "manager-only",
            "append-only",
            "partitioned"
          ]
        }
      }
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "method"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 80
        },
        "method": {
          "enum": [
            "evidence-weighted",
            "independent-judge",
            "manager-decision",
            "operator-approval"
          ]
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successConditions",
        "stopConditions",
        "maxRounds"
      ],
      "properties": {
        "successConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "stopConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "agents-sdk",
              "codex",
              "claude-code",
              "gemini",
              "mcp"
            ]
          }
        }
      }
    }
  }
}
