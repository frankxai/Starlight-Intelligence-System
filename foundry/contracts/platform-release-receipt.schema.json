{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/platform-release-receipt.schema.json",
  "title": "Starlight Foundry Platform Release Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "createdAt",
    "expiresAt",
    "subject",
    "host",
    "adapter",
    "distribution",
    "run",
    "checks",
    "evidence",
    "claims",
    "officialSourceUrls",
    "attestation",
    "waiver"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receiptId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "gitSha",
        "artifactSha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sbomSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryId",
        "surface",
        "version",
        "channel",
        "os",
        "arch",
        "plan",
        "locale"
      ],
      "properties": {
        "registryId": {
          "enum": [
            "openai-chatgpt-codex",
            "openai-custom-gpt",
            "anthropic-claude",
            "cursor-agent-plugins",
            "github-copilot-vscode",
            "google-antigravity",
            "google-gemini-cli",
            "google-gemini-spark",
            "google-workspace-marketplace",
            "google-gemini-enterprise",
            "xai-grok-build",
            "manus-skills-mcp",
            "hermes-agent-plugins",
            "opencode-plugins",
            "kiro-powers",
            "devin-plugins",
            "cline-mcp-skills",
            "jetbrains-junie",
            "zed-mcp",
            "roo-code-sunset"
          ]
        },
        "surface": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "preview"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "format",
        "version",
        "transport"
      ],
      "properties": {
        "tier": {
          "enum": [
            "portable",
            "native",
            "mcp-only",
            "instruction-pack",
            "unsupported"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http",
            "sse",
            "not-applicable"
          ]
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "listingUrl",
        "listingId",
        "reviewState",
        "installedVersion"
      ],
      "properties": {
        "mode": {
          "enum": [
            "public-marketplace",
            "team-marketplace",
            "git",
            "npm",
            "direct",
            "not-applicable"
          ]
        },
        "listingUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "listingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewState": {
          "enum": [
            "approved",
            "pending",
            "not-applicable",
            "blocked"
          ]
        },
        "installedVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "suiteVersion",
        "workflowRunUrl",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "mode": {
          "enum": [
            "headless",
            "human",
            "hybrid"
          ]
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "workflowRunUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
          },
          "capability": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-applicable"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "uri",
          "sha256",
          "capturedAt",
          "redacted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "type": {
            "enum": [
              "screenshot",
              "video",
              "transcript",
              "log",
              "trace",
              "junit",
              "environment",
              "listing-snapshot"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "redacted": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "surface",
          "state",
          "owner",
          "verifiedAt",
          "expiresAt",
          "limitations",
          "evidenceRefs"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "surface": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "state": {
            "enum": [
              "documented",
              "compatible",
              "verified",
              "published",
              "supported",
              "degraded",
              "blocked",
              "unsupported"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "officialSourceUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "method",
        "signature",
        "artifactSha256",
        "verificationUrl"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "method": {
          "enum": [
            "sigstore",
            "github-oidc",
            "human-review"
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4000
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verificationUrl": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1000
        }
      }
    },
    "waiver": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reason",
        "owner",
        "expiresAt"
      ]
    }
  }
}
