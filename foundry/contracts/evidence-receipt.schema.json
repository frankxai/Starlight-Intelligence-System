{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/evidence-receipt.schema.json",
  "title": "Starlight Foundry Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "packageId",
    "packageVersion",
    "createdAt",
    "status",
    "summary",
    "tests",
    "laneCoverage",
    "artifacts",
    "unresolved"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "validated",
        "experimental",
        "revise",
        "rejected"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "pending",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "type",
          "required",
          "status",
          "durationMs",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "lane": {
            "type": "string",
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "maxLength": 40
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "pending",
              "skipped"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "detail": {
            "type": "string",
            "maxLength": 3000
          }
        }
      }
    },
    "laneCoverage": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "passed",
          "failed",
          "pending",
          "not-required"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
