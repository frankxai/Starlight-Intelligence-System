{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/route-prompt.mjs\"",
            "statusMessage": "Loading Starlight activation router",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/route-prompt.mjs\"",
            "statusMessage": "Routing Starlight context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/route-prompt.mjs\"",
            "statusMessage": "Checking Starlight tool policy",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
