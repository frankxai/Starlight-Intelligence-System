{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/foundry/agent-pack.schema.json",
  "title": "Starlight Foundry Agent Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "description",
    "necessity",
    "decisionRights",
    "skills",
    "toolPolicy",
    "memoryContract",
    "handoffs",
    "termination",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "agent"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "necessity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "persistentDecisionRights",
        "distinctMemoryScope",
        "constrainedToolBoundary",
        "ownershipTransfer",
        "ongoingTrigger"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1500
        },
        "persistentDecisionRights": {
          "type": "boolean"
        },
        "distinctMemoryScope": {
          "type": "boolean"
        },
        "constrainedToolBoundary": {
          "type": "boolean"
        },
        "ownershipTransfer": {
          "type": "boolean"
        },
        "ongoingTrigger": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "persistentDecisionRights": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "distinctMemoryScope": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "constrainedToolBoundary": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "ownershipTransfer": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "ongoingTrigger": {
              "const": true
            }
          }
        }
      ]
    },
    "decisionRights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/-]{1,127}$"
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "deny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "memoryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "retention"
      ],
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "retention": {
          "enum": [
            "turn",
            "session",
            "durable"
          ]
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "target"
        ],
        "properties": {
          "when": {
            "type": "string",
            "maxLength": 500
          },
          "target": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "maxTurns"
      ],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace-agent",
              "agents-sdk",
              "codex",
              "claude-code",
              "gemini"
            ]
          }
        }
      }
    }
  }
}
