{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UmweltCapabilityReport",
  "description": "Schema for local environment tool capabilities in env.json",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "os": {
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "release": { "type": "string" },
        "arch": { "type": "string" }
      },
      "required": ["platform", "release", "arch"]
    },
    "shell": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["type"]
    },
    "tools": {
      "type": "object",
      "properties": {
        "git": { "type": ["string", "null"] },
        "node": { "type": ["string", "null"] },
        "bun": { "type": ["string", "null"] },
        "uv": { "type": ["string", "null"] },
        "mise": { "type": ["string", "null"] },
        "bat": { "type": ["string", "null"] },
        "lazygit": { "type": ["string", "null"] },
        "agy": { "type": ["string", "null"] },
        "grok": { "type": ["string", "null"] },
        "claude": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "required": ["timestamp", "os", "shell", "tools"]
}
