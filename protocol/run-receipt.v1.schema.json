{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.ai/schemas/starlight.run_receipt.v1.json",
  "title": "Starlight run receipt v1",
  "description": "The unit of proof for agent work: what a run did, what it cost, how long it took, who decided at each gate, and which evidence remains. Signed as a DSSE v1 envelope around an in-toto Statement v1 with Ed25519; predicateType https://starlightintelligence.ai/protocol/run-receipt/v1. The reference implementation is src/run-receipt.ts in the Starlight Intelligence System (signRunReceipt, verifyRunReceipt), exposed as the sis.receipt.issue and sis.receipt.verify MCP tools. protocol/sign.mjs and protocol/verify.mjs handle the SIP conformance receipt only, and no public verifier reads this predicate yet. Rules the schema cannot express and the verifier enforces: run.endedAt is not before run.startedAt; issuedAt is not before run.endedAt; issuer.keyid may be absent on an unsigned draft (sis.receipt.issue without a signing key), but a signed envelope must name it and a trusted signature by exactly that key must verify (every co-signer is checked, so order does not matter); cost and token totals are never below the stage sums, with costs compared allowing only for rounding (0.00005 EUR per priced stage plus 0.00005 EUR for the total); no decision.at is after issuedAt; every decision with decidedBy=human requires actor-bound proof (signature, mandateId, approvalRef, evidenceRef, or proof); totals.latencyMs is never below the longest stage; verdict PASS is refused when any stage failed, when every stage was skipped (at least one stage must succeed), or when evidence is empty; every evidence entry requires sha256 binding the referenced content; a DSSE envelope carries at most 8 signatures; the in-toto statement names exactly one subject whose name and sha256 equal the receipt's subject.",
  "type": "object",
  "required": [
    "schema",
    "receiptId",
    "issuedAt",
    "issuer",
    "run",
    "subject",
    "stages",
    "totals",
    "decisions",
    "evidence",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "starlight.run-receipt.v1"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "keyid": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the signing public key's SPKI DER. Set by the signer. Optional on an unsigned draft; a signed envelope without it is refused, so the issuer is never self-asserted."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "host",
        "startedAt",
        "endedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. desk.brief, constellation, publish, eval"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. claude-code, codex, grok, antigravity, cowork, workflow"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "required": [
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped"
            ]
          },
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "costEur": {
            "type": "number",
            "minimum": 0
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "costEur",
        "latencyMs",
        "tokens"
      ],
      "additionalProperties": false,
      "description": "Cost and tokens are never below the stage sums and may exceed them when the issuer tracks overhead. latencyMs is wall time: stages can overlap, so it is never below the longest stage.",
      "properties": {
        "costEur": {
          "type": "number",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "object",
          "required": [
            "input",
            "output"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "decidedBy",
          "actorId",
          "outcome",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "decidedBy": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "policy"
            ]
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "deferred"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "description": "Cryptographic signature or signature locator from the deciding human actor."
          },
          "mandateId": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier of the human mandate or authorization scope."
          },
          "approvalRef": {
            "type": "string",
            "minLength": 1,
            "description": "URL, PR review, or ledger id of the human approval record."
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "description": "Reference to an evidence record or artifact proving the human decision."
          },
          "proof": {
            "type": "string",
            "minLength": 1,
            "description": "Direct actor-bound proof token or reference for the human decision."
          }
        },
        "if": {
          "properties": {
            "decidedBy": {
              "const": "human"
            }
          }
        },
        "then": {
          "anyOf": [
            { "required": ["signature"] },
            { "required": ["mandateId"] },
            { "required": ["approvalRef"] },
            { "required": ["evidenceRef"] },
            { "required": ["proof"] }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL"
      ]
    }
  },
  "if": {
    "properties": {
      "verdict": {
        "const": "PASS"
      }
    }
  },
  "then": {
    "properties": {
      "evidence": {
        "minItems": 1
      }
    }
  }
}
