{
  "name": "@starlight-intelligence/core",
  "version": "0.2.0",
  "private": false,
  "description": "Portable SIS memory and protocol contracts with local sanitization.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/work-packet": "./schemas/work-packet.schema.json",
    "./schemas/agent-run": "./schemas/agent-run.schema.json",
    "./schemas/agent-event": "./schemas/agent-event.schema.json",
    "./schemas/decision": "./schemas/decision.schema.json",
    "./schemas/artifact": "./schemas/artifact.schema.json",
    "./schemas/pack": "./schemas/pack.schema.json",
    "./schemas/permission": "./schemas/permission.schema.json",
    "./schemas/approval-gate": "./schemas/approval-gate.schema.json",
    "./schemas/council-review": "./schemas/council-review.schema.json",
    "./schemas/graph-entity": "./schemas/graph-entity.schema.json",
    "./schemas/graph-edge": "./schemas/graph-edge.schema.json",
    "./schemas/cost-record": "./schemas/cost-record.schema.json",
    "./schemas/eval-result": "./schemas/eval-result.schema.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankxai/Starlight-Intelligence-System.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
