{
  "name": "@starlight-intelligence/agent-runtime",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Provider-neutral agent runtime for the Starlight estate: Gateway model routing, MCP tools with approval and drift control, and run attribution.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankxai/Starlight-Intelligence-System.git",
    "directory": "packages/agent-runtime"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "ai": "7.0.170",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.97",
    "@starlight-intelligence/core": "workspace:^",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "ai": "^7.0.130"
  }
}
