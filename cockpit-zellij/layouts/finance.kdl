// Finance & Business IS cockpit — generated 2026-05-11
//
// Launch: arc finance
// Or:     zellij --layout finance --session finance
//
// Per Board REVISE-3 (mirrored from W2 cost-plane): cockpit-only dashboard.
// Real financial numbers (P&L, runway, cash) live here, reading JSONL directly
// from memory/_audit/finance/ and memory/_audit/cost/. Never traverses network.
//
// Pane geometry:
//
//   +--------------------------------------------------------------+
//   |  CONDUCTOR (Claude session, left 60%, full-height)           |
//   |                                              +- REV TAIL ----|
//   |                                              | latest        |
//   |                                              | snapshots     |
//   |                                              +-- STATUS -----|
//   |                                              | P&L + runway  |
//   |                                              | per entity    |
//   |                                              +-- CRON --------|
//   |                                              | next snapshot |
//   |                                              | last result   |
//   +----------------------------------------------+---------------+

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Finance" focus=true {
        pane split_direction="vertical" {
            pane size="60%" name="Conductor" {
                command "claude"
                args "--resume" "finance" "--model" "claude-opus-4-7"
            }
            pane split_direction="horizontal" {
                pane name="RevenueTail" {
                    command "pwsh"
                    args "-NoExit" "-File" "./cockpit-zellij\\scripts\\tail-finance.ps1"
                }
                pane name="PnLStatus" {
                    command "pwsh"
                    args "-NoExit" "-File" "./cockpit-zellij\\scripts\\finance-status.ps1"
                }
                pane name="Cron" {
                    command "pwsh"
                    args "-NoExit" "-Command" "Write-Host '=== Finance cron status ===' -ForegroundColor Cyan; $log = 'memory\\_audit\\finance\\_cron.log'; if (Test-Path $log) { Get-Content -Path $log -Wait -Tail 30 } else { Write-Host 'No cron log yet — run scripts/cron/daily-revenue-snapshot.ps1' -ForegroundColor Yellow; while ($true) { Start-Sleep -Seconds 5; if (Test-Path $log) { Get-Content -Path $log -Wait -Tail 30; break } } }"
                }
            }
        }
    }

    tab name="Entities" {
        pane name="registry" {
            command "pwsh"
            args "-NoExit" "-Command" "Write-Host '=== Entity registry ===' -ForegroundColor Cyan; if (Test-Path 'private\\business-registry.json') { Get-Content -Path 'private\\business-registry.json' | ConvertFrom-Json | ConvertTo-Json -Depth 10 } else { Write-Host 'private/business-registry.json not set up.' -ForegroundColor Yellow; Write-Host ''; Write-Host 'cp business-registry.template.json private/business-registry.json'; Write-Host 'then fill in real entity values.' }"
        }
    }
}
