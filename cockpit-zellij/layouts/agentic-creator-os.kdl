// agentic-creator-os cockpit -- generated from _template.kdl.tmpl
//
// Launch: arc agentic-creator-os
// Or:     zellij --layout agentic-creator-os --session agentic-creator-os
//
// In the Dispatcher pane, run:  claude --resume agentic-creator-os
// (or auto-launched via cockpit-profile.json — see cockpit-zellij/PROFILES.md)
//
// Pane geometry (Orchestrator tab):
//
//   +------------------------------------------------------------+
//   |  DISPATCHER (top, full-width, 30% height)                  |
//   +----------+----------+----------+----------+----------------+
//   |  CLAUDE  |  CODEX   |  GEMINI  | OPENCODE |  (4 workers)   |
//   +----------+----------+----------+----------+----------------+

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Orchestrator" focus=true {
        pane split_direction="horizontal" {
            pane size="30%" name="Dispatcher" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "claude"
            args "--resume" "agentic-creator-os"
        }
            pane split_direction="vertical" {
                pane name="Claude" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "claude"
            args "--model" "claude-opus-4-7"
        }
                pane name="Codex" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "codex"
        }
                pane name="Gemini" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "gemini"
            args "--yolo" "-m" "gemini-2.5-pro"
        }
                pane name="OpenCode" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "opencode"
        }
            }
        }
    }

    tab name="Files" {
        pane name="files" cwd="C:\\Users\\frank\\agentic-creator-os"
    }

    tab name="Status" {
        pane name="git" cwd="C:\\Users\\frank\\agentic-creator-os"
    }

    tab name="Debug" {
        pane name="logs" cwd="C:\\Users\\frank\\agentic-creator-os"
    }

    tab name="Audit" {
        pane name="audit-tail" cwd="C:\\Users\\frank\\agentic-creator-os" {
            command "pwsh"
            args "-NoExit" "-File" "C:\\Users\\frank\\Starlight-Intelligence-System\\cockpit-zellij\\scripts\\tail-audit.ps1"
        }
    }
}

