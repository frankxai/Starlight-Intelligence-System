// frankx-prod-ai-coe-live cockpit -- generated from _template.kdl.tmpl
//
// Launch: arc frankx-prod-ai-coe-live
// Or:     zellij --layout frankx-prod-ai-coe-live --session frankx-prod-ai-coe-live
//
// In the Dispatcher pane, run:  claude --resume frankx-prod-ai-coe-live
// (or auto-launched via cockpit-profile.json — see cockpit-zellij/PROFILES.md)
//
// Pane geometry (Orchestrator tab):
//
//   +------------------------------------------------------------+
//   |  DISPATCHER (top, full-width, 30% height)                  |
//   +----------+----------+----------+----------+----------------+
//   |  CLAUDE  |  CODEX   |  GEMINI  | OPENCODE |  (4 workers)   |
//   +----------+----------+----------+----------+----------------+

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Orchestrator" focus=true {
        pane split_direction="horizontal" {
            pane size="30%" name="Dispatcher" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
            pane split_direction="vertical" {
                pane name="Claude" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
                pane name="Codex" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
                pane name="Gemini" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live" command="gemini" {
            args "--yolo"
        }
                pane name="OpenCode" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live" command="opencode"
            }
        }
    }

    tab name="Files" {
        pane name="files" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
    }

    tab name="Status" {
        pane name="git" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
    }

    tab name="Debug" {
        pane name="logs" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live"
    }

    tab name="Audit" {
        pane name="audit-tail" cwd="C:\\Users\\frank\\frankx-prod-ai-coe-live" command="pwsh" {
            args "-NoExit" "-File" "C:\\Users\\frank\\Starlight-Intelligence-System\\cockpit-zellij\\scripts\\tail-audit.ps1"
        }
    }
}

