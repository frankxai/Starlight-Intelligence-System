// arcanea.ai cockpit -- generated from _template.kdl.tmpl
//
// Launch: arc arcanea-ai
// Or:     zellij --layout arcanea-ai --session arcanea-ai
//
// In the Dispatcher pane, run:  claude --resume arcanea-ai
// for a persistent named conversation that survives sleeps.
//
// Pane geometry (Orchestrator tab):
//
//   +---------------------------------------------------+
//   |  DISPATCHER (top, full-width, 30% height)         |
//   |  Run: claude --resume arcanea-ai             |
//   +-------------+-------------+-----------------------+
//   |   CLAUDE    |   CODEX     |   GEMINI              |
//   +-------------+-------------+-----------------------+

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Orchestrator" focus=true {
        pane split_direction="horizontal" {
            pane size="30%" name="Dispatcher" cwd="C:\\Users\\frank\\arcanea.ai"
            pane split_direction="vertical" {
                pane name="Claude" cwd="C:\\Users\\frank\\arcanea.ai"
                pane name="Codex" cwd="C:\\Users\\frank\\arcanea.ai"
                pane name="Gemini" cwd="C:\\Users\\frank\\arcanea.ai"
            }
        }
    }

    tab name="Files" {
        pane name="files" cwd="C:\\Users\\frank\\arcanea.ai"
    }

    tab name="Status" {
        pane name="git" cwd="C:\\Users\\frank\\arcanea.ai"
    }

    tab name="Debug" {
        pane name="logs" cwd="C:\\Users\\frank\\arcanea.ai"
    }
}

