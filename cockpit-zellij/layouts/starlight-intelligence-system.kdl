// Starlight-Intelligence-System cockpit -- generated from _template.kdl.tmpl
//
// Launch: arc starlight-intelligence-system
// Or:     zellij --layout starlight-intelligence-system --session starlight-intelligence-system
//
// In the Dispatcher pane, run:  claude --resume starlight-intelligence-system
// (or auto-launched via cockpit-profile.json — see cockpit-zellij/PROFILES.md)
//
// Pane geometry (Orchestrator tab):
//
//   +------------------------------------------------------------+
//   |  DISPATCHER (top, full-width, 30% height)                  |
//   +----------+----------+----------+----------+----------------+
//   |  CLAUDE  |  CODEX   |  GEMINI  | OPENCODE |  (4 workers)   |
//   +----------+----------+----------+----------+----------------+

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Orchestrator" focus=true {
        pane split_direction="horizontal" {
            pane size="30%" name="Dispatcher" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="claude" {
            args "--resume" "starlight-intelligence-system"
        }
            pane split_direction="vertical" {
                pane name="Claude" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="claude" {
            args "--continue" "--model" "claude-opus-4-7"
        }
                pane name="Codex" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="codex.cmd" {
            args "resume" "--last"
        }
                pane name="Gemini" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="gemini.cmd" {
            args "--yolo" "-m" "gemini-2.5-pro"
        }
                pane name="OpenCode" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="opencode.cmd"
            }
        }
    }

    tab name="Files" {
        pane name="files" cwd="C:\\Users\\frank\\Starlight-Intelligence-System"
    }

    tab name="Status" {
        pane name="git" cwd="C:\\Users\\frank\\Starlight-Intelligence-System"
    }

    tab name="Debug" {
        pane name="logs" cwd="C:\\Users\\frank\\Starlight-Intelligence-System"
    }

    tab name="Audit" {
        pane name="audit-tail" cwd="C:\\Users\\frank\\Starlight-Intelligence-System" command="pwsh" {
            args "-NoExit" "-File" "C:\\Users\\frank\\Starlight-Intelligence-System\\cockpit-zellij\\scripts\\tail-audit.ps1"
        }
    }
}

