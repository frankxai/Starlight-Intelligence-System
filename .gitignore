node_modules/
.starlight/
*.tsbuildinfo

# Build output — published to npm via package.json `files`, never tracked in git.
# `npm run build` and `prepublishOnly` regenerate. `git checkout HEAD -- dist/` if needed.
dist/

# Private substrate state — never commit
private/
sis files/
sis files.zip
*.zip
noosphere/

# Local Claude Code settings + worktrees (per-machine)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Obsidian vault config (per-machine)
.obsidian/

# Peak Performance audit cache (operator-private, regenerable)
.pp/

# Audit artifacts that leak to repo root from sub-agent curl-with-tilde-expansion bugs
Usersfrank_audit_*

# Runtime knowledge-graph artifacts (auto-regenerated by brain_watchdog daemon)
memory/knowledge-graph/_brain-cache.json
memory/knowledge-graph/index.jsonl

# SIS memory orchestrator v0.1 runtime — operator-private state, never commit.
# Atom store, vector index, and audit log all live here. DECISIONS.md stays tracked.
# Includes /yolo session logs (memory/_audit/yolo/) and cost-plane snapshots
# (memory/_audit/cost/) per Board REVISE-3 — cost data is operator-private.
memory/_audit/
memory/mempalace/
memory/benchmarks/*.json

